# Supabase direct Postgres connection string (server-only)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Generate long independent secrets; pass via Authorization: Bearer <secret>
CRON_SECRET=
ADMIN_SYNC_SECRET=
# Optional: activates the official free Ticketmaster Discovery API adapter.
TICKETMASTER_API_KEY=
APP_TIMEZONE=America/Chicago
